{% set tags = get_all_tags() %}
{% set tag_styles = { 'Aplicaciones Moviles' : 'bg-warning', 
			'Ciberseguridad' : 'bg-success',
			'Desarrollo Web' : 'bg-primary', 
			'Productividad' : 'bg-secondary', 
			'Sistemas' : 'bg-info', 
			'Sociedad' : 'bg-danger', 
			'Economia' : 'bg-primary', 
			'Inteligencia Artificial' : 'bg-dark', 
			'Privacidad' : 'bg-success', 
		} 
%}

<aside class="pradera-sidebar" role="complementary" aria-label="Contenido lateral">
    <!-- Search widget (ids shared with search-behavior.twig) -->
    <div class="pradera-widget card mb-4">
		<div class="card-header">Búsqueda</div>
		<div class="card-body">
		    <div class="input-group">
			<input id="search_input" class="form-control" type="search" placeholder="Introduce términos de búsqueda…" aria-label="Términos de búsqueda" autocomplete="off" />
			<button class="btn btn-primary" id="search_submit" type="button">Buscar</button>
		    </div>
		</div>
    </div>
    <div class="pradera-widget card mb-4">
		<div class="card-header">Archivo</div>
		<div class="card-body">
		    <p class="small text-muted mb-2">Entradas agrupadas por año y mes.</p>
		    <a href="{{ 'archivo'|link }}" class="btn btn-outline-primary btn-sm w-100">Ver archivo →</a>
		</div>
    </div>
    {% if post_series is defined and post_series %}
    <div class="pradera-widget card mb-4 pradera-series-sidebar">
		<div class="card-header">Serie</div>
		<div class="card-body pb-2">
			<p class="small text-muted mb-2">Parte {{ post_series.index }} de {{ post_series.total }}</p>
			<p class="mb-0"><a class="fw-semibold text-decoration-none" href="{{ post_series.url }}">{{ post_series.name }}</a></p>
		</div>
		<div class="list-group list-group-flush">
			{% if post_series.prev %}
			<a class="list-group-item list-group-item-action pradera-series-sidebar__link" href="{{ post_series.prev.url }}" rel="prev">
				<span class="d-block text-muted text-uppercase small">← Parte anterior</span>
				<span class="d-block text-body text-break">{{ post_series.prev.title }}</span>
			</a>
			{% else %}
			<div class="list-group-item small text-muted">Inicio de la serie</div>
			{% endif %}
			{% if post_series.next %}
			<a class="list-group-item list-group-item-action pradera-series-sidebar__link" href="{{ post_series.next.url }}" rel="next">
				<span class="d-block text-muted text-uppercase small">Siguiente parte →</span>
				<span class="d-block text-body text-break">{{ post_series.next.title }}</span>
			</a>
			{% else %}
			<div class="list-group-item small text-muted">Última parte publicada</div>
			{% endif %}
		</div>
		<div class="card-body pt-2">
			<a class="btn btn-outline-primary btn-sm w-100" href="{{ post_series.url }}">Ver índice completo</a>
		</div>
    </div>
    {% endif %}
    <!-- Categories widget -->
    <div class="pradera-widget card mb-4">
		<div class="card-header">Categorías</div>
		<div class="card-body">
		    <div class="row">
		   {% for tag_group in tags|sort|batch(5) %}
			<div class="col-sm-6">
			    <ul class="list-unstyled mb-0">
				{% for tag in tag_group %}
					<li><a class="pradera-pill-tag badge rounded-pill{{ attribute(tag_styles, tag) is defined ? ' ' ~ attribute(tag_styles, tag) : ' bg-secondary' }} text-decoration-none link-light" href="{{ base_url }}/tags/?tag={{ tag|e('url') }}">{{ tag }}</a></li>
				{% endfor %}
			    </ul>
			</div>
		   {% endfor %}
		    </div>
		</div>
    </div>
    <!-- Recent posts (replaces default "Side Widget" placeholder) -->
    <div class="pradera-widget card mb-4 sidebar-recent">
		<div class="card-header">Artículos recientes</div>
		<div class="list-group list-group-flush">
			{% for page in pages|sort_by("time")|reverse if page.id starts with "blog/" %}
			{% if loop.index <= 5 %}
			<a class="list-group-item list-group-item-action sidebar-recent__link" href="{{ page.url }}">
				<span class="d-block fw-semibold text-body sidebar-recent__title text-break">{{ page.title }}</span>
				<span class="d-block small text-muted mt-1">{{ page.date }}</span>
			</a>
			{% endif %}
			{% endfor %}
		</div>
    </div>
</aside>
