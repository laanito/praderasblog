{% set tags = get_all_tags() %}
{% set tag_styles = { 'Aplicaciones Moviles' : 'bg-warning', 
			'Ciberseguridad' : 'bg-success',
			'Desarrollo Web' : 'bg-primary', 
			'Productividad' : 'bg-secondary', 
			'Sistemas' : 'bg-info', 
			'Sociedad' : 'bg-danger', 
			'Economia' : 'bg-primary', 
			'Inteligencia Artificial' : 'bg-dark', 
			'Privacidad' : 'bg-success', 
		} 
%}
{% set is_en = content_lang is defined and content_lang == 'en' %}
{% set _tag_label_en = tag_label_en|default({}) %}
{% set _tag_hub = is_en ? ("en/tags"|link) : ("tags"|link) %}

<aside class="pradera-sidebar" role="complementary" aria-label="{{ is_en ? 'Sidebar' : 'Contenido lateral' }}">
    <!-- Search widget (ids shared with search-behavior.twig) -->
    <div class="pradera-widget card mb-4">
		<div class="card-header">{{ is_en ? 'Search' : 'Búsqueda' }}</div>
		<div class="card-body">
		    <div class="input-group">
			<input id="search_input" class="form-control" type="search" placeholder="{{ is_en ? 'Enter search terms…' : 'Introduce términos de búsqueda…' }}" aria-label="{{ is_en ? 'Search terms' : 'Términos de búsqueda' }}" autocomplete="off" />
			<button class="btn btn-primary" id="search_submit" type="button">{{ is_en ? 'Search' : 'Buscar' }}</button>
		    </div>
		</div>
    </div>
    <div class="pradera-widget card mb-4">
		<div class="card-header">{{ is_en ? 'Archive' : 'Archivo' }}</div>
		<div class="card-body">
		    <p class="small text-muted mb-2">{{ is_en ? 'Posts by year and month (English only on this site).' : 'Entradas agrupadas por año y mes.' }}</p>
		    <a href="{{ is_en ? ("en/archivo"|link) : ("archivo"|link) }}" class="btn btn-outline-primary btn-sm w-100">{{ is_en ? 'View archive →' : 'Ver archivo →' }}</a>
		</div>
    </div>
    <div class="pradera-widget card mb-4">
		<div class="card-header">{{ is_en ? 'Stats' : 'Estadísticas' }}</div>
		<div class="card-body">
		    <p class="small text-muted mb-2">{{ is_en ? 'Aggregate HTML + JSON traffic (no third-party trackers).' : 'Tráfico HTML + JSON agregado (sin rastreadores externos).' }}</p>
		    <a href="{{ is_en ? ("en/stats"|link) : ("estadisticas"|link) }}" class="btn btn-outline-secondary btn-sm w-100">{{ is_en ? 'View stats →' : 'Ver estadísticas →' }}</a>
		</div>
    </div>
    {% if post_series is defined and post_series %}
    <div class="pradera-widget card mb-4 pradera-series-sidebar">
		<div class="card-header">{{ is_en ? 'Series' : 'Serie' }}</div>
		<div class="card-body pb-2">
			<p class="small text-muted mb-2">{{ is_en ? ('Part ' ~ post_series.index ~ ' of ' ~ post_series.total) : ('Parte ' ~ post_series.index ~ ' de ' ~ post_series.total) }}</p>
			<p class="mb-0"><a class="fw-semibold text-decoration-none" href="{{ post_series.url }}">{{ post_series.name }}</a></p>
		</div>
		<div class="list-group list-group-flush">
			{% if post_series.prev %}
			<a class="list-group-item list-group-item-action pradera-series-sidebar__link" href="{{ post_series.prev.url }}" rel="prev">
				<span class="d-block text-muted text-uppercase small">{{ is_en ? '← Previous part' : '← Parte anterior' }}</span>
				<span class="d-block text-body text-break">{{ post_series.prev.title }}</span>
			</a>
			{% else %}
			<div class="list-group-item small text-muted">{{ is_en ? 'Series start' : 'Inicio de la serie' }}</div>
			{% endif %}
			{% if post_series.next %}
			<a class="list-group-item list-group-item-action pradera-series-sidebar__link" href="{{ post_series.next.url }}" rel="next">
				<span class="d-block text-muted text-uppercase small">{{ is_en ? 'Next part →' : 'Siguiente parte →' }}</span>
				<span class="d-block text-body text-break">{{ post_series.next.title }}</span>
			</a>
			{% else %}
			<div class="list-group-item small text-muted">{{ is_en ? 'Latest published part' : 'Última parte publicada' }}</div>
			{% endif %}
		</div>
		<div class="card-body pt-2">
			<a class="btn btn-outline-primary btn-sm w-100" href="{{ post_series.url }}">{{ is_en ? 'Full series index' : 'Ver índice completo' }}</a>
		</div>
    </div>
    {% endif %}
    <!-- Categories widget -->
    <div class="pradera-widget card mb-4">
		<div class="card-header">{{ is_en ? 'Categories' : 'Categorías' }}</div>
		<div class="card-body">
		    <div class="row">
		   {% for tag_group in tags|sort|batch(5) %}
			<div class="col-sm-6">
			    <ul class="list-unstyled mb-0">
				{% for tag in tag_group %}
					<li><a class="pradera-pill-tag badge rounded-pill{{ attribute(tag_styles, tag) is defined ? ' ' ~ attribute(tag_styles, tag) : ' bg-secondary' }} text-decoration-none link-light" href="{{ _tag_hub }}?tag={{ tag|e('url') }}">{{ is_en ? attribute(_tag_label_en, tag)|default(tag) : tag }}</a></li>
				{% endfor %}
			    </ul>
			</div>
		   {% endfor %}
		    </div>
		</div>
    </div>
    <!-- Recent posts (replaces default "Side Widget" placeholder) -->
    <div class="pradera-widget card mb-4 sidebar-recent">
		<div class="card-header">{{ is_en ? 'Recent posts' : 'Artículos recientes' }}</div>
		<div class="list-group list-group-flush">
			{% for page in pages|sort_by("time")|reverse if page.id starts with "blog/" and ((is_en and page.id starts with "blog/en/") or (not is_en and not (page.id starts with "blog/en/"))) %}
			{% if loop.index <= 5 %}
			<a class="list-group-item list-group-item-action sidebar-recent__link" href="{{ page.url }}">
				<span class="d-block fw-semibold text-body sidebar-recent__title text-break">{{ page.title }}</span>
				<span class="d-block small text-muted mt-1">{{ page.date }}</span>
			</a>
			{% endif %}
			{% endfor %}
		</div>
    </div>
    <div class="pradera-widget card mb-4 sidebar-affiliate">
		<div class="card-header">{{ is_en ? 'Sponsored' : 'Patrocinado' }}</div>
		<div class="card-body text-center py-3">
			<a class="sidebar-affiliate__link d-inline-block" href="https://www.time4vps.com/?affid=8565" rel="nofollow sponsored noopener" target="_blank">
				<img class="sidebar-affiliate__img" src="{{ base_url }}/assets/images/affiliates/time4vps-300x250.png" width="300" height="250" title="Time4VPS" alt="{{ is_en ? 'Time4VPS - VPS hosting in Europe' : 'Time4VPS — hosting VPS en Europa' }}" />
			</a>
		</div>
    </div>
</aside>
