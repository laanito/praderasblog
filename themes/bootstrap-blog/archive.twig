{% extends "index.twig" %}

{% set is_en = content_lang is defined and content_lang == 'en' %}
{% set meses_es = {
  '01': 'enero',
  '02': 'febrero',
  '03': 'marzo',
  '04': 'abril',
  '05': 'mayo',
  '06': 'junio',
  '07': 'julio',
  '08': 'agosto',
  '09': 'septiembre',
  '10': 'octubre',
  '11': 'noviembre',
  '12': 'diciembre'
} %}
{% set meses_en = {
  '01': 'January',
  '02': 'February',
  '03': 'March',
  '04': 'April',
  '05': 'May',
  '06': 'June',
  '07': 'July',
  '08': 'August',
  '09': 'September',
  '10': 'October',
  '11': 'November',
  '12': 'December'
} %}
{% set meses = is_en ? meses_en : meses_es %}
{% set _home_label = is_en ? 'Home' : 'Inicio' %}
{% set _home_url = pradera_home_url|default(is_en ? ("en/index"|link) : ("index"|link)) %}
{% set _archive_label = is_en ? 'Archive' : 'Archivo' %}

{% block breadcrumb %}
{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': _home_label, 'url': _home_url }, { 'label': _archive_label } ] } only %}
{% endblock %}

{% block content %}
<header class="mb-4">
	<h1 class="fw-bolder mb-2">{{ meta.title }}</h1>
	{% if meta.description %}<p class="text-muted lead">{{ meta.description }}</p>{% endif %}
</header>

{% set sorted = pages|sort_by('time')|reverse %}
{% set last_year = '' %}
{% set last_month = '' %}

<div class="pradera-archive">
{% for p in sorted %}
{% if (is_en and p.id starts with 'blog/en/') or (not is_en and p.id starts with 'blog/' and not (p.id starts with 'blog/en/')) %}
{% if p.title %}
	{% set y = p.time|date('Y') %}
	{% set m = p.time|date('m') %}
	{% if y != last_year %}
		{% if last_month != '' %}
			</ul>
			{% set last_month = '' %}
		{% endif %}
		<h2 class="h4 mt-4 mb-2 pradera-archive__year">{{ y }}</h2>
		{% set last_year = y %}
	{% endif %}
	{% if m != last_month %}
		{% if last_month != '' %}
			</ul>
		{% endif %}
		<h3 class="h6 text-muted mt-3 mb-2 pradera-archive__month">{{ attribute(meses, m) }} {{ y }}</h3>
		<ul class="list-unstyled mb-3 pradera-archive__list">
		{% set last_month = m %}
	{% endif %}
	<li class="mb-2"><a href="{{ p.url }}">{{ p.title }}</a> <span class="text-muted small">{{ p.date }}</span></li>
{% endif %}
{% endif %}
{% endfor %}
{% if last_month != '' %}
</ul>
{% endif %}
</div>
{% endblock %}
