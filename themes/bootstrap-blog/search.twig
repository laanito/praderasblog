{% extends "index.twig" %}
{% set is_en = content_lang is defined and content_lang == 'en' %}

{% block breadcrumb %}
{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': is_en ? 'Home' : 'Inicio', 'url': pradera_home_url|default("index"|link) }, { 'label': is_en ? 'Search' : 'Búsqueda' } ] } only %}
{% endblock %}

{% block content %}
    {{ parent() }}

	{% if search_terms %}
	      {% set search_results = pages|apply_search %}
	      {% if search_results %}

		<div class="col-lg-12">
		<header class="mb-4">
		<!-- Page title-->
			<h1 class="fw-bolder mb-1">{{ is_en ? 'Search results for' : 'Resultados de la búsqueda para' }}&nbsp;{{ search_terms|e('html') }}</h1>
		</header>
	   	</div>
		  {% for page in search_results %}
			<div class="pradera-post-card card mb-4">
				<a href="{{ page.url }}"><img class="card-img-top" src="https://picsum.photos/750/300/?blur&random={{ page.date }}" alt="Random Image from picsum" /></a>
				<div class="card-body">
					<div class="small text-muted">{{ page.date }}</div>
					<h2 class="card-title h4">{{ page.title }}</h2>
					<p class="card-text">{{ page.description }}</p>
					<a class="btn btn-primary" href="{{ page.url }}">{{ is_en ? 'Read more' : 'Leer más' }} →</a>
				</div>
			</div>
		  {% endfor %}
	      {% else %}
		<div class="col-lg-12">
		<header class="mb-4">
		<!-- Page title-->
		<h1 class="fw-bolder mb-1">{{ is_en ? 'No results for' : 'No hay resultados para' }}&nbsp;{{ search_terms|e('html') }}</h1>
		</header>
	   	</div>
	      {% endif %}
	{% endif %}
{% endblock content %}
