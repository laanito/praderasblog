{% extends "index.twig" %}

{% block content %}
    {{ parent() }}

	{% if search_terms %}
	      {% set search_results = pages|apply_search %}
	      {% if search_results %}

		<div class="col-lg-12">
		<header class="mb-4">
		<!-- Page title-->
			<h1 class="fw-bolder mb-1">Resultados de la búsqueda para&nbsp;{{ search_terms|e('html') }}</h1>
		</header>
	   	</div>
		  {% for page in search_results %}
			<div class="card mb-4">
				<a href="{{ page.url }}"><img class="card-img-top" src="https://picsum.photos/750/300/?blur&random={{ page.date }}" alt="Random Image from picsum" /></a>
				<div class="card-body">
					<div class="small text-muted">{{ page.date }}</div>
					<h2 class="card-title h4">{{ page.title }}</h2>
					<p class="card-text">{{ page.description }}</p>
					<a class="btn btn-primary" href="{{ page.url }}">Leer más →</a>
				</div>
			</div>
		  {% endfor %}
	      {% else %}
		<div class="col-lg-12">
		<header class="mb-4">
		<!-- Page title-->
		<h1 class="fw-bolder mb-1">No hay resultados para&nbsp;{{ search_terms|e('html') }}</h1>
		</header>
	   	</div>
	      {% endif %}
	{% endif %}
{% endblock content %}
