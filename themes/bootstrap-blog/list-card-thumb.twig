{% import 'praderas-macros.twig' as pradera %}
{# Shared listing thumbnail: meta.image when set, else Lorem Picsum (stable seed from page.id / url). Expects `page` with .meta; wrap with <a href="{{ page.url }}"> in parent. #}
{% set picsum_seed = (page.id|default(page.url|default('post')))|replace({'/':'-'}) %}
{% set thumb_src = pradera.resolve_visual_cover_url(page.meta.image|default(''), picsum_seed, 400, 200) %}
<img class="card-img-top pradera-list-card-thumb" src="{{ thumb_src|e('html_attr') }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
