{# Shared listing thumbnail: meta.image when set, else Lorem Picsum with stable seed from page.id (fallback page.url). Expects `page` with .meta; wrap with <a href="{{ page.url }}"> in parent. #}
{% set thumb = page.meta.image|default('')|trim %}
{% if thumb %}
<img class="card-img-top pradera-list-card-thumb" src="{{ thumb|e('html_attr') }}" alt="" loading="lazy" decoding="async" />
{% else %}
{% set picsum_seed = (page.id|default(page.url|default('post')))|replace({'/':'-'}) %}
<img class="card-img-top pradera-list-card-thumb" src="https://picsum.photos/seed/{{ picsum_seed|e('url') }}/400/200" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
{% endif %}
