
{% set tags = get_all_tags() %}
{% set tag_styles = { 'Aplicaciones Moviles' : 'bg-warning', 
			'Ciberseguridad' : 'bg-success',
			'Desarrollo Web' : 'bg-primary', 
			'Productividad' : 'bg-secondary', 
			'Sistemas' : 'bg-info', 
			'Sociedad' : 'bg-danger', 
			'Economia' : 'bg-primary', 
			'Inteligencia Artificial' : 'bg-dark', 
			'Privacidad' : 'bg-success', 
		} 
%}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{% if meta.title %}{{ meta.title }} | {% endif %}{{ site_title }}</title>
    {% if meta.description %}
        <meta name="description" content="{{ meta.description|striptags }}">
    {% endif %}{% if meta.robots %}
        <meta name="robots" content="{{ meta.robots }}">
    {% endif %}
    <link rel="icon" type="image/x-icon" href="{{ theme_url }}/assets/favicon.ico" />
    <link rel="stylesheet" href="{{ theme_url }}/css/styles.css" />
</head>
<body>
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
            <a href="{{ "index"|link }}" class="navbar-brand">{{ site_title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    {% for page in pages if page.title %}
                    {% if not (page.id starts with "blog/") and (page.id not in ["search","tags"])  %}
                        <li class="nav-item{% if page.id == current_page.id %} active{% endif %}">
                            <a class="nav-link" href="{{ page.url }}">{{ page.title }}</a>
                        </li>
                         {% endif %}
                    {% endfor %}
                </ul>
            </div>
        </div>
   </nav>
   <!-- Page Content-->
   <div class="container mt-5">
	<!-- Header row -->
           <div class="row">
		<div class="col-lg-8">
		<header class="mb-4">
		<!-- Page title-->
			<h1 class="fw-bolder mb-1">{{ meta.title }}</h1>
		</header>
	   	</div>
		</div>
	<!-- End of Header Row -->
	<!-- Content row -->
	<div class="row">
	   <!-- Content Area -->
	   <div class="col-lg-8">
	   {% if paged_pages %}
	    {% for page_pair in paged_pages|sort_by("time")|reverse|batch(2) %} 
		<div class="row">
			{% for page in page_pair %}
			<div class="col-lg-6">
			<div class="card mb-4">
				<a href="{{ page.url }}"><img class="card-img-top" src="https://picsum.photos/750/300/?blur&random={{ page.date }}" alt="Random Image from picsum" /></a>
				<div class="card-body">
					<div class="small text-muted">{{ page.date }}</div>
					<h2 class="card-title h4">{{ page.title }}</h2>
					<p class="card-text">{{ page.description }}</p>
					<a class="btn btn-primary" href="{{ page.url }}">Leer más →</a>
				</div>
			</div>
			</div>
			{% endfor %}
		</div>
	  {% endfor %} 
	  {% endif %}
	  </div>
	  <!-- End of Content Area -->
	<!-- Side widgets-->
	<div class="col-lg-4">
	    <!-- Search widget-->
	    <div class="card mb-4">
		<div class="card-header">Search</div>
		<div class="card-body">
		    <div class="input-group">
			<input class="form-control" type="text" placeholder="Enter search term..." aria-label="Enter search term..." aria-describedby="button-search" />
			<button class="btn btn-primary" id="button-search" type="button">Go!</button>
		    </div>
		</div>
	    </div>
	    <!-- End of search widget -->
	    <!-- Categories widget-->
	    <div class="card mb-4">
		<div class="card-header">Categorías</div>
		<div class="card-body">
		    <div class="row">
		   {% for tag_group in tags|sort|batch(5) %}
			<div class="col-sm-6">
			    <ul class="list-unstyled mb-0">
				{% for tag in tag_group %}
					<li><a class="badge {{ attribute(tag_styles, tag) is defined ? ' ' ~ attribute(tag_styles, tag) : " bg-secondary" }} text-decoration-none link-light" href="{{ base_url }}/tags/?tag={{ tag }}">{{ tag }}</a></li>
				{% endfor %} 
			    </ul>
			</div>
		   {% endfor %}
		    </div>
		</div>
	    </div>
	    <!-- End of Categories -->
	    <!-- Side widget-->
	    <div class="card mb-4">
		<div class="card-header">Side Widget</div>
		<div class="card-body">You can put anything you want inside of these side widgets. They are easy to use, and feature the Bootstrap 5 card component!</div>
	    </div>
	    <!-- End of Side widget -->
	</div>
	<!-- End of Side Widgets -->
	</div>
				 
</div>
   <!-- Footer-->
    <footer class="py-5 bg-dark">
        <div class="container">
            <div class="social">
                {% for social in meta.social %}
                    <a href="{{ social.url }}" title="{{ social.title }}"><span class="icon-{{ social.icon }}"></span></a>
                {% endfor %}
            </div>
            <p class="m-0 text-center text-white">
                <a href="https://github.com/cutterkom/pico-blog-cms">Pico Blog Theme</a> was made by <a href="http://katharinabrunner.de">Katharina Brunner</a>, 
            <a href="http://picocms.org/">Pico</a> was made by <a href="http://gilbert.pellegrom.me">Gilbert Pellegrom</a>
            and is maintained by <a href="https://github.com/picocms/Pico/graphs/contributors">The Pico Community</a>.
            Released under the <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md">MIT license</a>.
            </p> </div>
    </footer>
        <!-- Bootstrap core JS-->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <!-- Core theme JS-->
        <script src="{{ theme_url }}/js/scripts.js"></script>

	<script type="text/javascript">
