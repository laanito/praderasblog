
<!DOCTYPE html>
<html lang="{{ html_lang|default('es') }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
{% include 'page-meta.twig' %}
</head>
<body class="praderas-site">
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark pradera-nav">
            <div class="container">
            <a href="{{ pradera_home_url|default("index"|link) }}" class="navbar-brand">{{ site_title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="{{ (content_lang is defined and content_lang == 'en') ? 'Toggle navigation' : 'Alternar navegación' }}"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {% include 'nav.twig' %}
            </div>
        </div>
   </nav>
   <!-- Page Content -->
   <div class="container mt-5">
           <div class="row">
		<div class="col-lg-8 pradera-main">
		{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Inicio', 'url': "index"|link }, { 'label': 'Blog' } ] } only %}
		<header class="pradera-list-header mb-4">
			<h1 class="fw-bolder mb-1">{{ meta.title }}</h1>
		</header>
	   {% if paged_pages %}
	    {% for page_pair in paged_pages|sort_by("time")|reverse|batch(2) %}
		<div class="row">
			{% for page in page_pair %}
			<div class="col-lg-6">
			<div class="pradera-post-card card mb-4">
				<a href="{{ page.url }}"><img class="card-img-top" src="https://picsum.photos/750/300/?blur&random={{ page.date }}" alt="" /></a>
				<div class="card-body">
					<div class="small text-muted">{{ page.date }}</div>
					<h2 class="card-title h4">{{ page.title }}</h2>
					<p class="card-text">{{ page.description }}</p>
					<a class="btn btn-primary" href="{{ page.url }}">Leer más →</a>
				</div>
			</div>
			</div>
			{% endfor %}
		</div>
	  {% endfor %}
	  {% endif %}
	  {% if total_pages is defined and total_pages > 1 and page_number is defined %}
	  <nav class="pradera-blog-pagination d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-2 my-4" aria-label="Páginas del blog">
		<div>
		{% if prev_page_url is defined and prev_page_url %}
		<a href="{{ prev_page_url }}" class="btn btn-outline-primary" id="prev_page_link">← Entradas anteriores</a>
		{% else %}
		<span class="btn btn-outline-secondary disabled" aria-disabled="true">← Entradas anteriores</span>
		{% endif %}
		</div>
		<p class="text-muted small m-0 align-self-center">Página {{ page_number }} de {{ total_pages }}</p>
		<div>
		{% if next_page_url is defined and next_page_url %}
		<a href="{{ next_page_url }}" class="btn btn-outline-primary" id="next_page_link">Entradas recientes →</a>
		{% else %}
		<span class="btn btn-outline-secondary disabled" aria-disabled="true">Entradas recientes →</span>
		{% endif %}
		</div>
	  </nav>
	  {% endif %}
	  </div>
	<div class="col-lg-4">
	    {% include 'sidebar.twig' %}
	</div>
	</div>
</div>
   <!-- Footer -->
    <footer class="py-5 bg-dark pradera-footer">
        <div class="container">
            <div class="social">
                {% for social in meta.social %}
                    <a href="{{ social.url }}" title="{{ social.title }}"><span class="icon-{{ social.icon }}"></span></a>
                {% endfor %}
            </div>
            <p class="m-0 text-center pradera-footer__credit">Basado en <a href="https://github.com/cutterkom/pico-blog-cms" rel="noopener">Pico Blog Theme</a> (K. Brunner). <a href="http://picocms.org/">Pico CMS</a> (G. Pellegrom) — mantenido por la <a href="https://github.com/picocms/Pico/graphs/contributors" rel="noopener">comunidad</a> — <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md" rel="noopener">licencia MIT</a>.</p> </div>
    </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ theme_url }}/js/scripts.js"></script>
{% include 'search-behavior.twig' %}
</body>
</html>
