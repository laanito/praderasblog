{% extends "index.twig" %}

{% set is_en = content_lang is defined and content_lang == 'en' %}

{% set tag_blurbs_es = {
  'Aplicaciones Moviles': 'Desarrollo y buenas prácticas en móviles.',
  'Ciberseguridad': 'Protección de datos y entornos conectados.',
  'Crypto': 'Blockchain, activos y economía digital.',
  'Desarrollo Web': 'Herramientas, APIs y arquitectura en la web.',
  'Economia': 'Tendencias y análisis económico.',
  'Inteligencia Artificial': 'IA aplicada, producto y debate social.',
  'Privacidad': 'Control personal, redes y datos.',
  'Productividad': 'Herramientas, flujos y teletrabajo.',
  'Sistemas': 'Infra, software libre y administración.',
  'Sociedad': 'Tecnología y contexto social.'
} %}

{% set tag_blurbs_en = {
  'Aplicaciones Moviles': 'Mobile development and good practices.',
  'Ciberseguridad': 'Data protection and connected environments.',
  'Crypto': 'Blockchain, assets, and digital economy.',
  'Desarrollo Web': 'Tools, APIs, and web architecture.',
  'Economia': 'Trends and economic analysis.',
  'Inteligencia Artificial': 'Applied AI, product, and social debate.',
  'Privacidad': 'Personal control, social networks, and data.',
  'Productividad': 'Tools, workflows, and remote work.',
  'Sistemas': 'Infra, free software, and administration.',
  'Sociedad': 'Technology and social context.'
} %}

{% set tag_blurbs = is_en ? tag_blurbs_en : tag_blurbs_es %}

{% block breadcrumb %}
{% if is_en %}
{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Home', 'url': pradera_home_url|default("en/index"|link) }, { 'label': 'Categories' } ] } only %}
{% else %}
{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Inicio', 'url': "index"|link }, { 'label': 'Categorías' } ] } only %}
{% endif %}
{% endblock %}

{% block content %}
<header class="mb-4">
	<h1 class="fw-bolder mb-2">{{ meta.title }}</h1>
	{% if meta.description %}<p class="text-muted lead">{{ meta.description }}</p>{% endif %}
</header>
<div class="pradera-prose mb-4">
{{ content }}
</div>
<div class="row g-3 pradera-categories-grid">
{% for tag in get_all_tags()|sort %}
	{% set cnt = (tag_post_counts is defined and attribute(tag_post_counts, tag) is not same as(null)) ? attribute(tag_post_counts, tag) : 0 %}
	<div class="col-12 col-md-6 col-lg-4">
		<div class="card h-100 border-0 shadow-sm">
			<div class="card-body d-flex flex-column position-relative">
				<h2 class="h5 card-title mb-1">{{ tag }}</h2>
				<p class="text-muted small flex-grow-1 mb-1">
					{{ attribute(tag_blurbs, tag)|default(is_en ? ('Posts tagged «' ~ tag ~ '».') : ('Artículos bajo la etiqueta «' ~ tag ~ '».')) }}
					<br /><span class="d-inline-block mt-1"><strong>{{ cnt }}</strong> {% if is_en %}post{% if cnt != 1 %}s{% endif %}{% else %}entrada{% if cnt != 1 %}s{% endif %}{% endif %}</span>
				</p>
				<span class="text-primary small">{{ is_en ? 'View posts →' : 'Ver entradas →' }}</span>
				<a class="stretched-link" href="{{ base_url }}/tags/?tag={{ tag|e('url') }}"><span class="visually-hidden">{{ tag }}{{ is_en ? ': view posts' : ': ver entradas' }}</span></a>
			</div>
		</div>
	</div>
{% endfor %}
</div>
<p class="small text-muted mt-3 mb-0">
{% if is_en %}
You can also use the alphabetical list on <a href="{{ 'tags'|link }}">tags</a> or the sidebar <a href="{{ "search"|link }}">search</a> (Spanish UI on those routes for now).
{% else %}
También puedes usar el listado alfabético en <a href="{{ 'tags'|link }}">etiquetas</a> o el <a href="{{ "search"|link }}">buscador</a> del lateral.
{% endif %}
</p>
{% endblock %}
