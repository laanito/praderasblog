{#
  Primary navigation: ES default (Inicio, Blog, …); EN subset (Home, Blog, … under content/en/).
#}
{% if content_lang is defined and content_lang == 'en' %}
{% set main_nav = [
  [ 'en/index', 'Home' ],
  [ 'en/blog', 'Blog' ],
  [ 'en/man-in-the-loop', 'Man in the loop' ],
  [ 'en/series', 'Series' ],
  [ 'en/categorias', 'Categories' ],
  [ 'en/about-picocms', 'About' ],
] %}
{% else %}
{% set main_nav = [
  [ 'index', 'Inicio' ],
  [ 'blog', 'Blog' ],
  [ 'man-in-the-loop', 'Man in the loop' ],
  [ 'series', 'Series' ],
  [ 'categorias', 'Categorías' ],
  [ 'acerca-de-picocms', 'Acerca' ],
] %}
{% endif %}
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                {% for nav in main_nav %}
                {% for p in pages if p.id == nav[0] and p.title %}
                <li class="nav-item{% if p.id == current_page.id or (nav[0] == 'man-in-the-loop' and (current_page.id is defined) and (current_page.id == 'man-in-the-loop' or (current_page.id starts with 'man-in-the-loop/'))) or (nav[0] == 'en/man-in-the-loop' and (current_page.id is defined) and (current_page.id == 'en/man-in-the-loop' or (current_page.id starts with 'man-in-the-loop/'))) or (nav[0] == 'categorias' and (current_page.id is defined) and (current_page.id == 'tags')) or (nav[0] == 'en/categorias' and (current_page.id is defined) and ((current_page.id == 'tags') or (current_page.id == 'en/tags'))) %} active{% endif %}">
                    <a class="nav-link" href="{{ p.url }}">{{ nav[1] }}</a>
                </li>
                {% endfor %}
                {% endfor %}
                </ul>
                {% include 'lang-switcher.twig' %}
