{# Unified document title, meta description/robots, canonical URL, Open Graph, and Twitter cards. #}
{% import 'praderas-macros.twig' as pradera %}
{% set page_title_string = site_title %}
{% if meta.title is defined and meta.title %}
	{% if my_tag is defined and my_tag %}
		{% set page_title_string = meta.title ~ ' · ' ~ my_tag ~ ' | ' ~ site_title %}
	{% else %}
		{% set page_title_string = meta.title ~ ' | ' ~ site_title %}
	{% endif %}
{% elseif my_tag is defined and my_tag %}
	{% set page_title_string = my_tag ~ ' | ' ~ site_title %}
{% endif %}

<title>{{ page_title_string }}</title>
{% if meta.description %}
<meta name="description" content="{{ meta.description|striptags }}">
{% endif %}
{% if meta.robots %}
<meta name="robots" content="{{ meta.robots }}">
{% endif %}

{% set canonical_url = current_page.url|default(base_url) %}
{% if canonical_url|slice(0, 4) != 'http' %}
	{% set _canon_path = (canonical_url|slice(0, 1) == '/') ? canonical_url : '/' ~ canonical_url %}
	{% set canonical_url = base_url|default('')|trim('/') ~ _canon_path %}
{% endif %}
<link rel="canonical" href="{{ canonical_url }}" />

<meta property="og:locale" content="{{ og_locale|default('es_ES') }}" />
{% if og_locale_alternate is defined and og_locale_alternate %}
<meta property="og:locale:alternate" content="{{ og_locale_alternate }}" />
{% endif %}
{% if hreflang_alternates is defined and hreflang_alternates|length > 0 %}
{% for alt in hreflang_alternates %}
<link rel="alternate" hreflang="{{ alt.hreflang }}" href="{{ alt.href }}" />
{% endfor %}
{% endif %}
<meta property="og:site_name" content="{{ site_title }}" />
<meta property="og:title" content="{{ page_title_string }}" />
{% if meta.description %}
<meta property="og:description" content="{{ meta.description|striptags }}" />
{% endif %}
<meta property="og:url" content="{{ canonical_url }}" />
{% set _blog_post = current_page.id is defined and current_page.id starts with 'blog/' %}
{% set _mitl_post = current_page.id is defined and (current_page.id starts with 'man-in-the-loop/' or current_page.id starts with 'en/man-in-the-loop/') %}
{% set _article_post = _blog_post or _mitl_post %}
{% set _picsum_seed = (current_page.id|default(current_page.url|default('post')))|replace({'/':'-'}) %}
{% set _social_alt = meta.Image_Alt|default(meta.image_alt|default(page_title_string)) %}
{% set pradera_social_image_url = pradera.resolve_social_preview_url(meta.image|default(''), _picsum_seed, base_url, _article_post)|trim %}
{% if pradera_social_image_url != '' %}
<meta property="og:image" content="{{ pradera_social_image_url|e('html_attr') }}" />
<meta property="og:image:secure_url" content="{{ pradera_social_image_url|e('html_attr') }}" />
<meta property="og:image:alt" content="{{ _social_alt|e('html_attr') }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
{% endif %}
{% if _article_post %}
<meta property="og:type" content="article" />
{% else %}
<meta property="og:type" content="website" />
{% endif %}

<meta name="twitter:card" content="{{ pradera_social_image_url != '' ? 'summary_large_image' : 'summary' }}" />
<meta name="twitter:title" content="{{ page_title_string }}" />
{% if meta.description %}
<meta name="twitter:description" content="{{ meta.description|striptags }}" />
{% endif %}
{% if pradera_social_image_url != '' %}
<meta name="twitter:image" content="{{ pradera_social_image_url|e('html_attr') }}" />
<meta name="twitter:image:alt" content="{{ _social_alt|e('html_attr') }}" />
{% endif %}

<link rel="icon" type="image/x-icon" href="{{ theme_url }}/assets/favicon.ico" />
<link rel="stylesheet" href="{{ theme_url }}/css/styles.css" />
<link rel="stylesheet" href="{{ theme_url }}/css/praderas-theme.css" />
