{# Shared helpers: committed/absolute cover URL, or Lorem Picsum from a stable seed (same seed + size → stable raster). #}
{% macro resolve_visual_cover_url(meta_image, picsum_seed, width, height) %}
{% set cover = meta_image|default('')|trim %}
{% if cover != '' %}
{{- cover -}}
{% else %}
https://picsum.photos/seed/{{ picsum_seed|e('url') }}/{{ width }}/{{ height }}
{% endif %}
{% endmacro %}

{# Social preview (OG/Twitter): absolute HTTPS URL, 2:1 JPEG sibling for committed WebP heroes. #}
{% macro resolve_social_preview_url(meta_image, picsum_seed, base_url, is_article) %}
{% set cover = meta_image|default('')|trim %}
{% if is_article and cover == '' %}
https://picsum.photos/seed/{{ picsum_seed|e('url') }}/1200/630
{% elseif cover == '' %}
{% else %}
{% set path = cover %}
{% if path|slice(0, 4) != 'http' %}
{% if path|slice(-5) == '.webp' %}
{% set path = path|slice(0, -5) ~ '-social.jpg' %}
{% endif %}
{% set path = (path|slice(0, 1) == '/') ? path : '/' ~ path %}
{% set base = base_url|default('')|trim('/') %}
{{ base ~ path }}
{% else %}
{{ path }}
{% endif %}
{% endif %}
{% endmacro %}
