
<!DOCTYPE html>
<html lang="{{ html_lang|default('en') }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
{% include 'page-meta.twig' %}
</head>
<body class="praderas-site">
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark pradera-nav">
            <div class="container">
            <a href="{{ pradera_home_url|default("index"|link) }}" class="navbar-brand">{{ site_title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {% include 'nav.twig' %}
            </div>
        </div>
   </nav>
   <!-- Page Content -->
   <div class="container mt-5">
           <div class="row">
		<div class="col-lg-8 pradera-main">
		{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Home', 'url': pradera_home_url|default("index"|link) }, { 'label': 'Blog' } ] } only %}
		<header class="pradera-list-header mb-4">
			<h1 class="fw-bolder mb-1">{{ meta.title }}</h1>
		</header>
	    {% set en_shown = 0 %}
	    {% for page in pages|sort_by("time")|reverse %}
	    {% if page.id is defined and page.id starts with 'blog/en/' and page.title %}
	    {% if en_shown % 2 == 0 %}<div class="row">{% endif %}
			<div class="col-lg-6">
			<div class="pradera-post-card card mb-4">
				<a href="{{ page.url }}">{% include 'list-card-thumb.twig' with { 'page': page } only %}</a>
				<div class="card-body">
					<div class="small text-muted">{{ page.date }}</div>
					<h2 class="card-title h4">{{ page.title }}</h2>
					<p class="card-text">{{ page.description }}</p>
					<a class="btn btn-primary" href="{{ page.url }}">Read more →</a>
				</div>
			</div>
			</div>
	    {% set en_shown = en_shown + 1 %}
	    {% if en_shown % 2 == 0 %}</div>{% endif %}
	    {% endif %}
	    {% endfor %}
	    {% if en_shown % 2 == 1 %}</div>{% endif %}
	  </div>
	<div class="col-lg-4">
	    {% include 'sidebar.twig' %}
	</div>
	</div>
</div>
   <!-- Footer -->
    <footer class="py-5 bg-dark pradera-footer">
        <div class="container">
            <div class="social">
                {% for social in meta.social %}
                    <a href="{{ social.url }}" title="{{ social.title }}"><span class="icon-{{ social.icon }}"></span></a>
                {% endfor %}
            </div>
            <p class="m-0 text-center pradera-footer__credit">Based on <a href="https://github.com/cutterkom/pico-blog-cms" rel="noopener">Pico Blog Theme</a> (K. Brunner). <a href="http://picocms.org/">Pico CMS</a> (G. Pellegrom) — maintained by the <a href="https://github.com/picocms/Pico/graphs/contributors" rel="noopener">community</a> — <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md" rel="noopener">MIT license</a>.</p> </div>
    </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ theme_url }}/js/scripts.js"></script>
{% include 'search-behavior.twig' %}
</body>
</html>
