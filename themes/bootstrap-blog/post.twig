{% import 'praderas-macros.twig' as pradera %}

{% set tag_styles = { 'Aplicaciones Moviles' : 'bg-warning', 
			'Ciberseguridad' : 'bg-success',
			'Desarrollo Web' : 'bg-primary', 
			'Productividad' : 'bg-secondary', 
			'Sistemas' : 'bg-info', 
			'Sociedad' : 'bg-danger', 
			'Economia' : 'bg-primary', 
			'Inteligencia Artificial' : 'bg-dark', 
			'Privacidad' : 'bg-success', 
		} 
%}
{% set is_en = content_lang is defined and content_lang == 'en' %}
{% set _tag_label_en = tag_label_en|default({}) %}
{% set _tag_hub = is_en ? ("en/tags"|link) : ("tags"|link) %}

<!DOCTYPE html>
<html lang="{{ html_lang|default('es') }}">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
{% include 'page-meta.twig' %}
</head>
<body class="praderas-site">
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark pradera-nav">
            <div class="container">
            <a href="{{ pradera_home_url|default("index"|link) }}" class="navbar-brand">{{ site_title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="{{ is_en ? 'Toggle navigation' : 'Alternar navegación' }}"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {% include 'nav.twig' %}
            </div>
        </div>
   </nav>
   <!-- Page Content -->
   <div class="container mt-5">
           <div class="row">
		<div class="col-lg-8 pradera-main">
		{% set _home_label = is_en ? 'Home' : 'Inicio' %}
		{% set _home_url = pradera_home_url|default("index"|link) %}
		{% set _blog_url = is_en ? ("en/blog"|link) : ("blog"|link) %}
		{% if current_page.id is defined and current_page.id starts with "blog/" %}
			{% if meta.tags %}
				{% if meta.tags is iterable %}
					{% set t0 = meta.tags|first %}
				{% else %}
					{% set t0 = meta.tags|split(",")|first|trim %}
				{% endif %}
				{% set t0_crumb = is_en ? attribute(_tag_label_en, t0)|default(t0) : t0 %}
				{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': _home_label, 'url': _home_url }, { 'label': 'Blog', 'url': _blog_url }, { 'label': t0_crumb, 'url': _tag_hub ~ '?tag=' ~ t0|e('url') }, { 'label': meta.title } ] } only %}
			{% else %}
				{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': _home_label, 'url': _home_url }, { 'label': 'Blog', 'url': _blog_url }, { 'label': meta.title } ] } only %}
			{% endif %}
		{% else %}
			{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': _home_label, 'url': _home_url }, { 'label': meta.title } ] } only %}
		{% endif %}
		<article class="pradera-article pradera-main--reading">
			<header class="mb-4 pradera-post-header">
			<h1 class="fw-bolder mb-1">{{ meta.title }}</h1>
			<div class="pradera-post-meta text-muted fst-italic mb-0">
				{% if meta.date_formatted %}
				{{ is_en ? ('Published on ' ~ meta.date_formatted) : ('Publicado el ' ~ meta.date_formatted) }}
				{% endif %}
			</div>
			{% if meta.tags %}
			<div class="pradera-post-tags" role="list">
			{% for tag in meta.tags %}
				<a class="pradera-pill-tag badge rounded-pill{{ attribute(tag_styles, tag) is defined ? ' ' ~ attribute(tag_styles, tag) : ' bg-secondary' }} text-decoration-none link-light" role="listitem" href="{{ _tag_hub }}?tag={{ tag|e('url') }}">{{ is_en ? attribute(_tag_label_en, tag)|default(tag) : tag }}</a>
			{% endfor %}
			</div>
			{% endif %}
			</header>
			{% set _blog_article = current_page.id is defined and current_page.id starts with 'blog/' %}
			{% set _picsum_seed = (current_page.id|default(current_page.url|default('post')))|replace({'/':'-'}) %}
			{% set _hero_src = _blog_article ? pradera.resolve_visual_cover_url(meta.image|default(''), _picsum_seed, 1200, 630) : (meta.image|default('')|trim) %}
			{% if _hero_src != '' %}
			<figure class="pradera-hero-figure mb-4">
				<img class="pradera-hero-img img-fluid rounded shadow-sm" src="{{ _hero_src|e('html_attr') }}" alt="{{ meta.title|e('html_attr') }}" loading="lazy" decoding="async" referrerpolicy="no-referrer-when-downgrade" />
			</figure>
			{% endif %}
			<section class="mb-5 post-body">
                         {{ content }}
			</section>
		{% if current_page.id is defined and current_page.id starts with "blog/" %}
		{% if related_posts is defined and related_posts|length > 0 %}
			<aside class="pradera-related entry-related border-top pt-4 mt-4" aria-label="{{ is_en ? 'Related posts' : 'Entradas relacionadas' }}">
				<h2 class="h5 pradera-related__title">{{ is_en ? 'You may also like' : 'Te puede interesar' }}</h2>
				<ul class="list-unstyled pradera-related__list mb-0">
				{% for rp in related_posts %}
					<li>
						<a href="{{ rp.url }}" class="pradera-related__link">
							<span class="pradera-related__link-title">{{ rp.title }}</span>
							<span class="pradera-related__date">{{ rp.date }}</span>
						</a>
					</li>
				{% endfor %}
				</ul>
			</aside>
		{% endif %}
		<nav class="pradera-post-nav d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-start gap-3 border-top pt-4 mt-4" aria-label="{{ is_en ? 'Previous and next posts' : 'Entradas anteriores y posteriores' }}">
			<div class="flex-sm-fill me-sm-2">
			{% if post_prev_in_time is defined and post_prev_in_time %}
			<a href="{{ post_prev_in_time.url }}" class="d-block text-decoration-none" rel="prev">
				<span class="text-muted text-uppercase small d-block">{{ is_en ? '← Older' : '← Más antigua' }}</span>
				<span class="d-block text-body">{{ post_prev_in_time.title }}</span>
			</a>
			{% else %}
			<span class="text-muted small">{{ is_en ? 'Oldest in this language' : 'Inicio de la línea (cronológica)' }}</span>
			{% endif %}
			</div>
			<div class="flex-sm-fill text-sm-end ms-sm-2">
			{% if post_next_in_time is defined and post_next_in_time %}
			<a href="{{ post_next_in_time.url }}" class="d-block text-decoration-none" rel="next">
				<span class="text-muted text-uppercase small d-block">{{ is_en ? 'Newer →' : 'Más reciente →' }}</span>
				<span class="d-block text-body">{{ post_next_in_time.title }}</span>
			</a>
			{% else %}
			<span class="text-muted small d-block">{{ is_en ? 'Latest in this language for now' : 'Última (cronológica) por ahora' }}</span>
			{% endif %}
			</div>
		</nav>
		{% endif %}
		</article>
                </div>
		<div class="col-lg-4">
		{% include 'sidebar.twig' %}
		</div>
           </div>
   </div>

   <footer class="py-5 bg-dark pradera-footer">
        <div class="container">
            <div class="social">
                {% for social in meta.social %}
                    <a href="{{ social.url }}" title="{{ social.title }}"><span class="icon-{{ social.icon }}"></span></a>
                {% endfor %}
            </div>
            <p class="m-0 text-center pradera-footer__credit">{% if is_en %}Based on <a href="https://github.com/cutterkom/pico-blog-cms" rel="noopener">Pico Blog Theme</a> (K. Brunner). <a href="http://picocms.org/">Pico CMS</a> (G. Pellegrom) — maintained by the <a href="https://github.com/picocms/Pico/graphs/contributors" rel="noopener">community</a> — <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md" rel="noopener">MIT license</a>.{% else %}Basado en <a href="https://github.com/cutterkom/pico-blog-cms" rel="noopener">Pico Blog Theme</a> (K. Brunner). <a href="http://picocms.org/">Pico CMS</a> (G. Pellegrom) — mantenido por la <a href="https://github.com/picocms/Pico/graphs/contributors" rel="noopener">comunidad</a> — <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md" rel="noopener">licencia MIT</a>.{% endif %}</p> </div>
    </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ theme_url }}/js/scripts.js"></script>
{% include 'search-behavior.twig' %}
</body>
</html>
