
{% set tag_styles = { 'Aplicaciones Moviles' : 'bg-warning', 
			'Ciberseguridad' : 'bg-success',
			'Desarrollo Web' : 'bg-primary', 
			'Productividad' : 'bg-secondary', 
			'Sistemas' : 'bg-info', 
			'Sociedad' : 'bg-danger', 
			'Economia' : 'bg-primary', 
			'Inteligencia Artificial' : 'bg-dark', 
			'Privacidad' : 'bg-success', 
		} 
%}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{% if meta.title %}{{ meta.title }} | {% endif %}{{ site_title }}</title>
    {% if meta.description %}
        <meta name="description" content="{{ meta.description|striptags }}">
    {% endif %}{% if meta.robots %}
        <meta name="robots" content="{{ meta.robots }}">
    {% endif %}
    <link rel="icon" type="image/x-icon" href="{{ theme_url }}/assets/favicon.ico" />
    <link rel="stylesheet" href="{{ theme_url }}/css/styles.css" />
    <link rel="stylesheet" href="{{ theme_url }}/css/praderas-theme.css" />
</head>
<body class="praderas-site">
   <nav class="navbar navbar-expand-lg navbar-dark bg-dark pradera-nav">
            <div class="container">
            <a href="{{ "index"|link }}" class="navbar-brand">{{ site_title }}</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegación"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {% include 'nav.twig' %}
            </div>
        </div>
   </nav>
   <!-- Page Content -->
   <div class="container mt-5">
           <div class="row">
		<div class="col-lg-8 pradera-main">
		{% if current_page.id is defined and current_page.id starts with "blog/" %}
			{% if meta.tags %}
				{% if meta.tags is iterable %}
					{% set t0 = meta.tags|first %}
				{% else %}
					{% set t0 = meta.tags|split(",")|first|trim %}
				{% endif %}
				{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Inicio', 'url': "index"|link }, { 'label': 'Blog', 'url': "blog"|link }, { 'label': t0, 'url': base_url ~ '/tags/?tag=' ~ t0|e('url') }, { 'label': meta.title } ] } only %}
			{% else %}
				{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Inicio', 'url': "index"|link }, { 'label': 'Blog', 'url': "blog"|link }, { 'label': meta.title } ] } only %}
			{% endif %}
		{% else %}
			{% include 'breadcrumbs.twig' with { 'crumbs': [ { 'label': 'Inicio', 'url': "index"|link }, { 'label': meta.title } ] } only %}
		{% endif %}
		<article class="pradera-article pradera-main--reading">
			<header class="mb-4 pradera-post-header">
			<h1 class="fw-bolder mb-1">{{ meta.title }}</h1>
			<div class="pradera-post-meta text-muted fst-italic mb-0">
				{% if meta.date_formatted %}
				{{ 'Publicado el ' ~ meta.date_formatted }}
				{% endif %}
			</div>
			{% if meta.tags %}
			<div class="pradera-post-tags" role="list">
			{% for tag in meta.tags %}
				<a class="pradera-pill-tag badge rounded-pill{{ attribute(tag_styles, tag) is defined ? ' ' ~ attribute(tag_styles, tag) : ' bg-secondary' }} text-decoration-none link-light" role="listitem" href="{{ base_url }}/tags/?tag={{ tag|e('url') }}">{{ tag }}</a>
			{% endfor %}
			</div>
			{% endif %}
			</header>
                        <figure class="mb-4"><img class="img-fluid rounded" src="https://picsum.photos/900/400/?blur" alt="" /></figure>
			<section class="mb-5 post-body">
                         {{ content }}
			</section>
		{% if current_page.id is defined and current_page.id starts with "blog/" %}
		{% if post_series is defined and post_series %}
		<aside class="pradera-series-nav border-top pt-4 mt-4" aria-label="Navegación de serie">
			<h2 class="h5 pradera-series-nav__title">Serie: {{ post_series.name }}</h2>
			<p class="small text-muted mb-3">Parte {{ post_series.index }} de {{ post_series.total }}.</p>
			<nav class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-start gap-3" aria-label="Navegación dentro de la serie">
				<div class="flex-sm-fill me-sm-2">
				{% if post_series.prev %}
					<a href="{{ post_series.prev.url }}" class="d-block text-decoration-none pradera-series-nav__link" rel="prev">
						<span class="text-muted text-uppercase small d-block">← Parte anterior</span>
						<span class="d-block text-body">{{ post_series.prev.title }}</span>
					</a>
				{% else %}
					<span class="text-muted small">Inicio de la serie</span>
				{% endif %}
				</div>
				<div class="flex-sm-fill text-sm-center">
					<a href="{{ post_series.url }}" class="btn btn-outline-primary btn-sm">Índice de la serie</a>
				</div>
				<div class="flex-sm-fill text-sm-end ms-sm-2">
				{% if post_series.next %}
					<a href="{{ post_series.next.url }}" class="d-block text-decoration-none pradera-series-nav__link" rel="next">
						<span class="text-muted text-uppercase small d-block">Siguiente parte →</span>
						<span class="d-block text-body">{{ post_series.next.title }}</span>
					</a>
				{% else %}
					<span class="text-muted small d-block">Última parte publicada</span>
				{% endif %}
				</div>
			</nav>
		</aside>
		{% endif %}
		{% if related_posts is defined and related_posts|length > 0 %}
			<aside class="pradera-related entry-related border-top pt-4 mt-4" aria-label="Entradas relacionadas">
				<h2 class="h5 pradera-related__title">Te puede interesar</h2>
				<ul class="list-unstyled pradera-related__list mb-0">
				{% for rp in related_posts %}
					<li>
						<a href="{{ rp.url }}" class="pradera-related__link">
							<span class="pradera-related__link-title">{{ rp.title }}</span>
							<span class="pradera-related__date">{{ rp.date }}</span>
						</a>
					</li>
				{% endfor %}
				</ul>
			</aside>
		{% endif %}
		<nav class="pradera-post-nav d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-start gap-3 border-top pt-4 mt-4" aria-label="Entradas anteriores y posteriores">
			<div class="flex-sm-fill me-sm-2">
			{% if post_prev_in_time is defined and post_prev_in_time %}
			<a href="{{ post_prev_in_time.url }}" class="d-block text-decoration-none" rel="prev">
				<span class="text-muted text-uppercase small d-block">← Más antigua</span>
				<span class="d-block text-body">{{ post_prev_in_time.title }}</span>
			</a>
			{% else %}
			<span class="text-muted small">Inicio de la línea (cronológica)</span>
			{% endif %}
			</div>
			<div class="flex-sm-fill text-sm-end ms-sm-2">
			{% if post_next_in_time is defined and post_next_in_time %}
			<a href="{{ post_next_in_time.url }}" class="d-block text-decoration-none" rel="next">
				<span class="text-muted text-uppercase small d-block">Más reciente →</span>
				<span class="d-block text-body">{{ post_next_in_time.title }}</span>
			</a>
			{% else %}
			<span class="text-muted small d-block">Última (cronológica) por ahora</span>
			{% endif %}
			</div>
		</nav>
		{% endif %}
		</article>
                </div>
		<div class="col-lg-4">
		{% include 'sidebar.twig' %}
		</div>
           </div>
   </div>

   <footer class="py-5 bg-dark pradera-footer">
        <div class="container">
            <div class="social">
                {% for social in meta.social %}
                    <a href="{{ social.url }}" title="{{ social.title }}"><span class="icon-{{ social.icon }}"></span></a>
                {% endfor %}
            </div>
            <p class="m-0 text-center pradera-footer__credit">Basado en <a href="https://github.com/cutterkom/pico-blog-cms" rel="noopener">Pico Blog Theme</a> (K. Brunner). <a href="http://picocms.org/">Pico CMS</a> (G. Pellegrom) — mantenido por la <a href="https://github.com/picocms/Pico/graphs/contributors" rel="noopener">comunidad</a> — <a href="https://github.com/picocms/Pico/blob/master/LICENSE.md" rel="noopener">licencia MIT</a>.</p> </div>
    </footer>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="{{ theme_url }}/js/scripts.js"></script>
{% include 'search-behavior.twig' %}
</body>
</html>
